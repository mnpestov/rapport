generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pattern {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  url       String
  imageUrl  String
  isFree    Boolean  @default(false)
  isNew     Boolean  @default(false)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  instruments Instrument[]
  categories  ProductType[]
  tags        Tag[]
  favoritedBy UserFavorite[]
  views       PatternView[]
  linkClicks  PatternLinkClick[]
}

model Author {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
}

model ProductType {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
}

model Instrument {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
}

enum UserRole {
  USER
  AUTHOR
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  telegramId   BigInt   @unique
  firstName    String
  lastName     String?
  username     String?
  languageCode String?
  isPremium    Boolean  @default(false)
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites         UserFavorite[]
  patternViews      PatternView[]
  patternLinkClicks PatternLinkClick[]
  subscribeClicks   SubscribeClick[]
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([userId, patternId])
}

// ---------------------------------------------------------------------------
// Web / admin authentication — one-time login codes delivered via Telegram.
// Decoupled from the Mini App auth flow (which stays as telegramAuth).
// ---------------------------------------------------------------------------
model LoginCode {
  id         String    @id @default(cuid())
  telegramId BigInt

  code      String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([telegramId])
}

// ---------------------------------------------------------------------------
// Analytics — append-only telemetry. userId/patternId are stored as plain
// indexed scalars (no FK) so events survive user/pattern deletion and the
// existing User/Pattern models stay untouched.
// ---------------------------------------------------------------------------
model PatternView {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model PatternLinkClick {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model SubscribeClick {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Whitelist — users who bypass the subscription gate.
// telegramId is stored as BigInt to match the User model.
// createdBy stores the admin's userId as a plain string (no FK) so entries
// survive admin account deletions.
// ---------------------------------------------------------------------------
model WhitelistedUser {
  id           String   @id @default(uuid())
  telegramId   BigInt   @unique
  username     String?
  firstName    String?
  lastName     String?
  comment      String?
  forceAllow                   Boolean   @default(false)
  debugLogging                 Boolean   @default(false)
  needsInvestigation           Boolean   @default(false)
  lastWhitelistAuthorizationAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
}
