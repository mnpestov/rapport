generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pattern {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  url             String
  // Derived — always kept equal to images[0] by the backend on every write.
  // Never edited directly; exists because every "just the cover" read site
  // (catalog card, admin list/grid views, novelty cards) needs a plain
  // required string, not an array.
  imageUrl        String
  // Small (≤800px) derivative of images[0], for card/list contexts only
  // (catalog card, admin list/grid). Nullable — old rows are backfilled
  // gradually by the image-gallery backfill process, not in one migration;
  // every read site must fall back to imageUrl when this is null. NEVER
  // read on the pattern detail page — imageUrl (not this field) is what
  // non-premium users see there when `images` is empty, so imageUrl must
  // stay full quality, not this one.
  thumbnailUrl    String?
  images          String[]  @default([])
  // Long-form free text ("Подробности"), shown collapsed by default on the
  // detail page. Nullable (not "") so an empty/never-set block can be
  // omitted from the UI entirely via a plain truthy check. Will eventually
  // be populated by author_sync.py — see processSyncBatch's parsedData
  // fallback, already written to tolerate the key being absent today.
  details         String?
  // Absolute rubles, not a stored discount %/flag — oldPrice > price IS the
  // "discount active" signal, computed on display. Avoids the two numbers
  // going out of sync if only one gets edited later.
  price           Decimal?  @db.Decimal(10, 2)
  oldPrice        Decimal?  @db.Decimal(10, 2)
  isFree          Boolean   @default(false)
  isNew           Boolean   @default(false)
  isVisible       Boolean   @default(true)
  // Set once, the first time isVisible ever transitions to true — the actual
  // "went live" moment. Never touched again by later edits/re-hides, unlike
  // createdAt which for archive-queued sync items (isVisible: false at
  // creation) can predate real publication by however long it sits in
  // review. Anchor for the isNew auto-expiry job (see src/jobs).
  publishedAt     DateTime?
  densityStitches Decimal?  @db.Decimal(5, 2)
  densityRows     Decimal?  @db.Decimal(5, 2)
  // Оценка популярности для сортировки «Популярные». НЕ счётчик избранного:
  // сырые счётчики измеряют показы, а не интерес — бесплатных в каталоге
  // 2.9%, но им показывают в 6.7 раза больше, и по сырому избранному они
  // занимали весь топ-10. Здесь — доля открывших, которые сделали что-то
  // значимое (перешли к автору или добавили в избранное), сглаженная по
  // объёму. Считается фоновой задачей раз в сутки (src/jobs/popularity.ts),
  // а не запросом: агрегат по трём логам событий на каждую страницу
  // каталога не потянуть, да и балл не должен меняться в середине
  // прокрутки — иначе пагинация начнёт дублировать карточки.
  popularityScore Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authorId     String
  author       Author               @relation(fields: [authorId], references: [id])
  instruments  Instrument[]
  categories   ProductType[]
  tags         Tag[]
  yarnRanges   YarnRange[]
  favoritedBy  UserFavorite[]
  views        PatternView[]
  linkClicks   PatternLinkClick[]
  drafts       Draft[]
  yarns        PatternYarn[]
  yarnMentions PatternYarnMention[]
  priceAlerts  PriceAlert[]
  stashUsages  StashUsage[]

  @@index([popularityScore, id])
}

model Author {
  id          String             @id @default(uuid())
  name        String             @unique
  site        String?
  patterns    Pattern[]
  drafts      Draft[]
  syncReports AuthorSyncReport[]
  user        User?              @relation("UserAuthor")

  // Свободный текст для админа, пользователям не виден.
  comment                    String?
  // Мы запросили у автора разрешение публиковать его контент. Ставит админ вручную.
  contentPermissionRequested Boolean @default(false)
  // Автор попросил удалить себя из Раппорта. Ставит админ вручную. Пока
  // стоит — новинки автора (AuthorSyncReport) не показываются админу в
  // очереди модерации. Парсинг author_sync.py продолжается: автор может
  // передумать, снятие флага возвращает всё как было.
  removalRequested           Boolean @default(false)
  // Автор ОТВЕТИЛ согласием на размещение его контента — независимо от
  // contentPermissionRequested выше: то лишь факт, что мы запросили,
  // это поле про полученный ответ (согласие можно получить и без явного
  // запроса, если автор написал сам). Ставит админ вручную.
  contentPermissionGranted   Boolean @default(false)
}

model ProductType {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

model Instrument {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

// Fixed yarn-thickness buckets (m/100g), seeded — not user-creatable.
// sortOrder controls display order; maxValue is null for the open-ended top bucket ("701+").
model YarnRange {
  id        String    @id @default(uuid())
  label     String    @unique
  minValue  Int
  maxValue  Int?
  sortOrder Int       @default(0)
  patterns  Pattern[]
  drafts    Draft[]
}

// Справочник канонических волокон —seed из разбора реального Yarn.composition
// (~121 позиция на момент миграции), но не fixed-список: в отличие от
// YarnRange, админ может добавлять новые волокна прямо из формы одобрения
// пряжи, когда встречается волокно, которого ещё нет в словаре.
// baseFiber обязателен, остальные атрибуты — уточнения, известные не всегда
// (у половины исходных composition указано только базовое волокно без
// подвида/тонкости/обработки/происхождения).
model FiberType {
  id          String @id @default(uuid())
  baseFiber   String // "Шерсть", "Хлопок", "Альпака"…
  subtype     String? // "Меринос", "Бэби", "Сури"…
  grade       String? // "Экстрафайн", "Суперфайн"…
  treatment   String? // "Супервош", "Мерсеризация"…
  origin      String? // "Австралия", "Органическая"…
  // Готовое для UI/поиска имя — то же самое, что дал бы человек, глядя на
  // baseFiber+subtype+grade+treatment+origin, но не пересчитывается на
  // лету, чтобы не тянуть склейку в каждый список/автокомплит.
  displayName String  @unique
  sortOrder   Int     @default(0)

  compositions YarnComposition[]

  @@index([baseFiber])
}

// Разложение Yarn.composition на волокна с долями — один Yarn может иметь
// несколько строк (пряжа-смесь, «70% меринос, 30% полиамид»).
// Yarn.composition (сырой текст) не заменяется и не удаляется: он остаётся
// источником для парсинга и подсказкой админу при дозаполнении, пока не всё
// распознано автоматически.
model YarnComposition {
  id          String    @id @default(uuid())
  yarnId      String
  yarn        Yarn      @relation(fields: [yarnId], references: [id], onDelete: Cascade)
  fiberTypeId String
  fiberType   FiberType @relation(fields: [fiberTypeId], references: [id])
  // Доля не всегда известна из исходного текста ("шерсть, полиамид" без
  // процентов) — null, а не 0, означает именно «не указано».
  percentage  Int?

  @@unique([yarnId, fiberTypeId])
}

// Таблица заменителей волокон — на уровне FiberType.baseFiber (не
// конкретного канона с подтипом): "Меринос"/"Як"/"Ягнёнок" при поиске
// заменителей все сводятся к baseFiber "Шерсть", подтип не участвует в
// скоринге. Seed из rapport_fiber_substitutes.md (экспертная эвристика,
// сентябрь 2026), но не fixed-список — как и FiberType, может расширяться.
//
// Хранится ОДНОЙ строкой на симметричную пару (symmetric: true — читается
// в обе стороны кодом подбора; редкое исключение — symmetric: false,
// связь действует только source -> target).
model FiberSubstitute {
  id         String               @id @default(uuid())
  source     String // FiberType.baseFiber
  target     String // FiberType.baseFiber
  level      FiberSubstituteLevel // A/B/C — близость; X — явный запрет
  // По какой причине допустима замена — используется критичным
  // ограничением "не допускать альтернативу без обязательного
  // функционального компонента" (functional с долей ≥15% в оригинале,
  // не найденного среди сопоставленных пар, блокирует всю альтернативу).
  role       FiberSubstituteRole  @default(MATERIAL)
  symmetric  Boolean              @default(true)

  @@unique([source, target])
  @@index([source])
  @@index([target])
}

enum FiberSubstituteLevel {
  A
  B
  C
  X
}

enum FiberSubstituteRole {
  MATERIAL
  FUNCTIONAL
  VISUAL
  DECORATIVE
}

// ─── Артикулы пряжи ────────────────────────────────────────────────────────
// Отдельная сущность, а не поле у Pattern: на описание приходится в среднем
// 2,7 артикула, и одно поле выбросило бы больше половины связей. С YarnRange
// не пересекается и его не заменяет — YarnRange это диапазон метража, по
// которому идёт фильтр каталога, а здесь конкретная пряжа с именем.
model Yarn {
  id            String  @id @default(uuid())
  brand         String?
  line          String?
  // Полное «бренд + линейка» — то, что видит человек и по чему идёт поиск.
  name          String
  // Ключ сравнения: NFKC -> буквы-двойники -> нижний регистр -> выброс
  // «concept»/«by» -> транслитерация -> только буквы и цифры. Транслитерация
  // обязательна: авторы пишут «ализе» и «Alize» вперемешку.
  normalizedKey String  @unique
  // Отсортированное МНОЖЕСТВО нормализованных слов. Множество, а не
  // мультимножество: схлопывает и переставленный порядок («Baby Cotton XL» /
  // «Baby XL Cotton»), и задвоенный бренд («Infinity Design Design Air»).
  // Не уникален — служит для поиска дублей, а не для их запрета.
  dedupKey      String
  // Родовое название без марки: «Пух норки», «Эко-норка». У таких brand
  // совпадает с name, а line пуст — это свойство, а не пробел в данных.
  // Флаг нужен админке (не требовать бренд) и сопоставлению: родовые
  // обрабатываются последним правилом, и правило уровня бренда обязано их
  // пропускать, иначе перехватывает раньше.
  isGeneric     Boolean @default(false)

  // Характеристики — все необязательные: у трети карточек их нет вовсе.
  // Сырая строка и разобранные числа лежат рядом намеренно: строка нужна
  // человеку («4,5—5 мм»), числа — фильтрам. Тот же приём, что у
  // Pattern.densityStitches/densityRows.
  mPer100g        Int?
  composition     String?
  needleSizeRaw   String?
  needleMinMm     Float?
  needleMaxMm     Float?
  densityRaw      String?
  densityStitches Int?
  densityRows     Int?
  ballWeightG     Int?
  ballLengthM     Int?

  sourceName   String?
  sourceUrl    String?
  // Дедуп для повторных fallback-запросов к Ravelry (YARN_STASH_PLAN.md
  // Ravelry-fallback) — прежде чем идти за пряжей в их API снова, ищем по
  // этому полю: если карточка уже импортирована, просто дополняем её, а не
  // создаём дубль. sourceUrl не годится как ключ дедупа — там URL, который
  // Ravelry может переформатировать, id стабильнее.
  ravelryId    Int?           @unique
  // Справочное фото — предзаполняет StashSkein.images при выборе этой
  // пряжи в хранилище (сам Yarn до Ravelry-fallback фото не имел вообще,
  // фото жило только на конкретном мотке пользователя). Тот же
  // /uploads/yarn-stash/ пайплайн, что и фото мотка — см. imagePipeline.ts.
  photoUrl     String?
  isActive     Boolean        @default(true)
  // PENDING — создан автором через POST /author/yarns, ждёт проверки, не
  // виден в suggestYarns. APPROVED — прошёл проверку (или создан админом
  // через POST /admin/yarns — default), виден в справочнике как сейчас.
  // REJECTED — модератор отклонил личную заявку пользователя из хранилища
  // пряжи (YARN_STASH_PLAN.md §5.1): карточка не попадает в справочник и не
  // предлагается другим (suggestYarns фильтрует строго APPROVED), но
  // StashSkein-ссылки владельца продолжают на неё указывать — в отличие от
  // авторского PENDING-потока, где rejectPendingYarn удаляет строку
  // физически, для личных заявок с хранилищем это стало бы потерей данных
  // пользователя. Не путать с YarnMentionStatus — тоже использует PENDING,
  // но для PatternYarnMention, не связанная модель.
  status       YarnStatus     @default(APPROVED)
  // Источник заявки — только для PENDING/REJECTED, различает уровень доверия
  // при модерации: AUTHOR — через существующий POST /author/yarns (узкий,
  // проверенный круг), STASH_USER — через POST /stash/yarns (потенциально
  // массовый источник опечаток/дублей, YARN_STASH_PLAN.md §5.4). Default
  // AUTHOR — весь текущий PENDING-поток на момент миграции идёт от авторов.
  createdVia   YarnCreatedVia @default(AUTHOR)
  // При слиянии дублей карточка не удаляется, а помечается ссылкой на
  // победителя: связи на неё уже могли разойтись по описаниям, и удаление
  // порвало бы их.
  mergedIntoId String?
  mergedInto   Yarn?          @relation("YarnMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Yarn[]         @relation("YarnMerge")

  aliases          YarnAlias[]
  patterns         PatternYarn[]
  drafts           DraftYarn[]
  suggestedFor     PatternYarnMention[]  @relation("YarnSuggested")
  resolvedFor      PatternYarnMention[]  @relation("YarnResolved")
  stashSkeins      StashSkein[]
  fieldSuggestions YarnFieldSuggestion[]
  compositions     YarnComposition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dedupKey])
  @@index([brand])
  @@index([status])
}

enum YarnCreatedVia {
  AUTHOR
  STASH_USER
}

// Заявка пользователя хранилища пряжи на дозаполнение пустых полей УЖЕ
// СУЩЕСТВУЮЩЕГО справочного артикула (metraж/состав/спицы и т.п.) — не
// новый артикул на модерации (для этого есть Yarn.status: PENDING), а
// именно дельта-предложение к живой APPROVED-записи. Разделены намеренно:
// смешать оба случая в одном Yarn.status привело бы к путанице "это новый
// артикул или правка старого?" прямо в очереди модерации.
//
// Поля-кандидаты — те же самые характеристики, что у Yarn, но ВСЕ nullable
// здесь независимо от Yarn: пользователь мог знать только метраж, не зная
// состав, тогда предлагается только mPer100g, остальные остаются null и не
// затрагиваются при одобрении.
model YarnFieldSuggestion {
  id     String @id @default(uuid())
  yarnId String
  yarn   Yarn   @relation(fields: [yarnId], references: [id], onDelete: Cascade)

  suggestedById String
  suggestedBy   User   @relation(fields: [suggestedById], references: [id])

  // Тот же StashSkein, из карточки которого пользователь увидел пробел в
  // данных — не обязателен (заявка переживает удаление скейна), но полезен
  // модератору как контекст ("почему вообще предложили это значение").
  stashSkeinId String?

  mPer100g      Int?
  composition   String?
  needleSizeRaw String?
  densityRaw    String?
  ballWeightG   Int?
  ballLengthM   Int?

  status YarnFieldSuggestionStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([yarnId])
  @@index([status])
}

enum YarnFieldSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Как пряжу пишут люди: опечатки («Lana Gossa»), транслитерации («Сеам»),
// авторские написания, а также цветовые варианты, схлопнутые при чистке
// («Rico Design Essentials Cotton DK banana 63»). Поиск смотрит и сюда, и в
// Yarn.normalizedKey.
model YarnAlias {
  id              String @id @default(uuid())
  yarnId          String
  yarn            Yarn   @relation(fields: [yarnId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String @unique

  createdAt DateTime @default(now())

  @@index([yarnId])
}

enum YarnStatus {
  PENDING
  APPROVED
  // Личная заявка пользователя из хранилища пряжи отклонена модератором —
  // см. Yarn.status и Yarn.createdVia выше (YARN_STASH_PLAN.md §5.1).
  REJECTED
}

enum YarnLinkSource {
  SCRAPER
  ADMIN
  BACKFILL
}

enum YarnLinkStatus {
  ACTIVE
  // «Человек удалил, не создавать заново». Без этого статуса перезапуск
  // бэкофила воскрешал бы связь: текст описания не менялся, разбор даст тот
  // же результат, и модератор удалял бы одно и то же по кругу.
  REJECTED
}

enum YarnMatchRule {
  EXACT
  // Автор ошибся в написании, и человек сверил, что он имел в виду.
  // Соответствия лежат в yarn_lib/corrections.py — это знание разбора, а не
  // свойство пряжи, поэтому в справочник опечатка не попадает.
  CORRECTION
  PARTIAL
  SHORT_FORM
  FAMILY
  LINE_NAME
  BRAND_LEVEL
  AUTHOR_METRAGE
  GENERIC
  MANUAL
}

// Связь «описание ↔ артикул». Роли (оригинал/альтернатива) у связи нет
// сознательно: цель — понять, из какой пряжи это изделие уже вязали, и обе
// роли отвечают на вопрос одинаково.
model PatternYarn {
  id        String  @id @default(uuid())
  patternId String
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  yarnId    String
  yarn      Yarn    @relation(fields: [yarnId], references: [id])

  // Как пряжа названа в тексте описания, дословно, и метраж оттуда же.
  // Метраж хранится здесь, а не переносится в Pattern.yarnRanges: это
  // авторский текст, мы его не меняем.
  rawMention    String?
  metrageInText String?

  source      YarnLinkSource
  status      YarnLinkStatus @default(ACTIVE)
  matchRule   YarnMatchRule?
  // Отпечаток details, с которого связь собрана. Правка описания в админке
  // связи не трогает, и без отпечатка расхождение больше негде заметить.
  detailsHash String?

  createdAt DateTime @default(now())

  @@unique([patternId, yarnId])
  @@index([patternId])
  @@index([yarnId])
}

enum YarnMentionKind {
  // «Meilenweit», «Merino Extrafine» — уровень семейства: карточка семейства
  // склеила бы нити разной толщины и сломала поиск.
  FAMILY
  // Названа только марка. Для «Katia» никакое пополнение справочника не
  // поможет — у бренда десятки линеек, и какая имелась в виду, не следует.
  BRAND_ONLY
  UNKNOWN_ARTICLE
}

enum YarnMentionStatus {
  PENDING
  RESOLVED
  REJECTED
}

// Упоминание пряжи, из которого связь не собралась. Данные не выбрасываем:
// по этой таблице строится рабочий список на пополнение справочника.
model PatternYarnMention {
  id        String  @id @default(uuid())
  patternId String
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  rawText         String
  metrageInText   String?
  kind            YarnMentionKind
  // Кандидат, предложенный правилом, у которого не хватило уверенности на
  // связь: «по названию линейки» даёт 36% точности, поэтому оно пишет
  // подсказку сюда, а не связь.
  suggestedYarnId String?
  suggestedYarn   Yarn?           @relation("YarnSuggested", fields: [suggestedYarnId], references: [id])
  matchRule       YarnMatchRule?
  resolvedYarnId  String?
  resolvedYarn    Yarn?           @relation("YarnResolved", fields: [resolvedYarnId], references: [id])

  status      YarnMentionStatus @default(PENDING)
  detailsHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Одно и то же название в одном описании — одно упоминание. Без этого
  // перезапуск бэкофила плодил бы копии, а решение модератора по одной из
  // них не распространялось бы на остальные.
  @@unique([patternId, rawText])
  @@index([patternId])
  @@index([status])
}

enum UserRole {
  USER
  AUTHOR
  ADMIN
}

enum DraftStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum Permission {
  MINI_APP
  AUTHOR_CABINET
  ADMIN
  PREMIUM_CORE
  PREMIUM_EXTRA
  PREMIUM_DETAILS
  // Доступ к браузерной версии на rapport.su (BROWSER_ACCESS_PLAN.md §3.5).
  // Выдаётся ботом автоматически в момент создания UserCredential, либо
  // админом вручную. AUTHOR_CABINET даёт его неявно (авторы и так входят в
  // кабинет через браузер). До публичного запуска это основной гейт: он же
  // позволяет пускать волнами и при желании сделать веб платным.
  //
  // НЕ отменяет проверку подписки на канал — та отдельный гейт поверх
  // (enforceWebSubscription).
  WEB_ACCESS
  // Позволяет подписываться на снижение цены описания и получать
  // уведомления в бот (implementation_plan.md — «Подписка на цены»).
  // Выдаётся платным пользователям из админки.
  PRICE_ALERT
  // Отдельный гейт для списка артикулов пряжи в карточке описания —
  // намеренно НЕ переиспользует PREMIUM_DETAILS ("Подробности") и НЕ
  // PREMIUM_CORE (фильтр/поиск по артикулу): своя фича со своим правом,
  // выдаётся из админки индивидуально.
  PREMIUM_YARNS
  // Личное хранилище пряжи пользователя (YARN_STASH_PLAN.md) — не путать с
  // PREMIUM_YARNS выше (тот гейтит показ справочных артикулов в карточке
  // ЧУЖОГО описания). Запускается ADMIN-only, без переходного бесплатного
  // периода (план §5.2) — совершенно новая фича без истории бесплатного
  // использования.
  PREMIUM_YARN_STASH
}

// Что именно произошло с баннером подписки. Append-only лог событий, из
// которого строится воронка (PAYMENTS_ROBOKASSA_PLAN.md §10).
// Хранить это в User.lastPaywallShownAt нельзя: то поле перезаписывается и
// на нём висит функциональный 7-дневный кулдаун показа.
enum PaywallEventType {
  SHOWN // баннер открылся
  SCROLLED_TO_END // долистал список функций до конца
  SUBSCRIBE_CLICK // нажал "Оформить подписку" / "Продлить"
  CLOSED // закрыл — кнопкой или тапом по затемнению, не различаем
  BUTTON_OPENED // открыл шторку кнопкой в строке поиска
}

// Откуда открылась шторка. Нужен и на событии, и на Payment: без источника
// нельзя ответить, окупается ли кнопка у поиска и работают ли напоминания.
// Задним числом не восстанавливается — единственная часть аналитики,
// которую нельзя отложить (§10.3, §10.7).
enum PaywallSource {
  AUTO_BANNER // автопоказ при входе
  SEARCH_BUTTON // кнопка подписки в строке поиска
  FILTER_LOCK // тап по платной секции в шторке фильтров
  EXPIRING_3_DAYS // предупреждение "истекает через 3 дня"
  EXPIRING_1_DAY // предупреждение "через 1 день"
  ACTIVE // шторка "подписка активна" (продление из неё)
  PRICE_ALERT_INTRO // разовый баннер "новая функция" — подписка на цены (действующим платным)
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id              String    @id @default(uuid())
  telegramId      BigInt    @unique
  firstName       String
  lastName        String?
  username        String?
  languageCode    String?
  isPremium       Boolean   @default(false)
  role            UserRole  @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastSeenAt      DateTime?
  // Канал последнего входа: "tg" (Mini App) или "web" (браузер). Пишется
  // в тех же местах, что и lastSeenAt (authController, createWebSession,
  // refresh). null — у пользователей, не заходивших после раскатки поля.
  lastSeenChannel String?
  platform        String?
  tgVersion       String?
  userAgent       String?

  // Paywall banner "1 in 7 days" gate — see PAYWALL_BANNER_PLAN.md §3.
  // lastPaywallClickedAt is not read anywhere yet, kept purely for future
  // conversion analytics (cheaper to add now than in a second migration).
  lastPaywallShownAt   DateTime?
  lastPaywallClickedAt DateTime?

  // Разовый баннер "новая функция" (подписка на цены) действующим платным
  // подписчикам — variant='price_alert_intro' в PaywallModal, 2026-09.
  // Отдельное поле, не lastPaywallShownAt: то перезаписывается и на нём
  // висит СВОЙ функциональный 7-дневный кулдаун обычного баннера — делить
  // одно поле между двумя разными механизмами показа значило бы, что показ
  // одного молча сбрасывает кулдаун другого. null = ещё не видел.
  priceAlertIntroShownAt DateTime?

  // Предупреждение об истечении подписки — по одному показу на каждый
  // этап (за 3 дня / за 1 день), не пересекаются с lastPaywallShownAt и
  // друг с другом: подписка может продлеваться много раз, и на каждый
  // новый цикл premiumExpiresAt оба поля сбрасываются заново в
  // completePayment (тот же момент, что задаёт новый premiumExpiresAt).
  // null = этот этап ещё не показывался в текущем цикле подписки.
  expiring3DaysShownAt DateTime?
  expiring1DayShownAt  DateTime?

  // Свои и тестовые аккаунты, которых не должно быть в статистике воронки
  // подписки (PAYMENTS_ROBOKASSA_PLAN.md §10). Отдельный флаг, а не роль:
  // "кто управляет системой" и "чья активность — тестовый шум" — разные
  // вещи, и помечать тестировщика не должно означать выдачу ему прав
  // админа. Переключается в карточке пользователя в админке.
  //
  // Сейчас влияет только на воронку подписки: основная статистика
  // дашборда (просмотры, переходы, топы) флаг не учитывает.
  excludeFromStats Boolean @default(false)

  // Paid subscription (Robokassa) — see PAYMENTS_ROBOKASSA_PLAN.md §5.2.
  // Denormalized the same way as Pattern.imageUrl: the only reader is the
  // daily reminder/revoke cron job. Access itself is still decided purely
  // by UserPermission (resolveRole, /auth/telegram permissions[], admin UI)
  // — nothing else needs to know this field exists.
  premiumExpiresAt DateTime?

  // Когда ушло напоминание "подписка заканчивается через 3 дня" за текущий
  // оплаченный период. Без этого поля cron слал бы его каждые сутки все
  // три дня подряд — окно "истекает в ближайшие 3 дня" совпадает при каждом
  // прогоне. Сбрасывается в null при каждой новой оплате, чтобы следующий
  // период снова получил своё напоминание (paymentsController.ts).
  premiumReminderSentAt DateTime?

  // Winback-опрос: мягкий чекин платным подписчикам, не заходившим ~12
  // дней (сентябрь 2026, план в чате) — независимо от premiumExpiresAt,
  // не пересекается с напоминанием о продлении выше. Временный кулдаун:
  // "протухает" (cron шлёт заново), если lastSeenAt обновился ПОСЛЕ этой
  // отметки — то есть человек заходил и снова замолчал, новый период
  // неактивности заслуживает новый чекин. В отличие от
  // premiumReminderSentAt, сброса на конкретное событие ("новая оплата")
  // нет — критерий сброса тут "заходил ли пользователь с тех пор".
  winbackCheckinSentAt DateTime?
  // Постоянный отказ ("Не спрашивать больше" в клавиатуре чекина) — в
  // отличие от winbackCheckinSentAt НЕ протухает при следующем визите,
  // cron исключает такого пользователя навсегда. Отдельное поле, а не
  // ещё одно значение WinbackReason: это не причина оттока, а отзыв
  // согласия на саму рассылку, разная семантика для статистики.
  winbackOptedOutAt DateTime?

  winbackResponses  WinbackResponse[]
  favorites         UserFavorite[]
  patternViews      PatternView[]
  patternLinkClicks PatternLinkClick[]
  subscribeClicks   SubscribeClick[]
  searchQueries     SearchQuery[]
  payments          Payment[]
  paywallEvents     PaywallEvent[]
  priceAlerts       PriceAlert[]

  authorId      String?          @unique
  author        Author?          @relation("UserAuthor", fields: [authorId], references: [id])
  permissions   UserPermission[]
  closedDrafts  Draft[]          @relation("DraftClosedBy")
  refreshTokens RefreshToken[]

  authorApplications   AuthorApplication[]
  credential           UserCredential?
  webSessions          WebSession[]
  stashSkeins          StashSkein[]
  yarnFieldSuggestions YarnFieldSuggestion[]
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([userId, patternId])
  // Составной unique выше начинается с userId и для группировки по
  // patternId бесполезен — а именно она нужна сортировке «Популярные»
  // (orderBy favoritedBy._count) и топам в админке.
  @@index([patternId])
}

// Which flow a LoginCode was issued for — webAuthController's /verify-code
// (web/admin OTP login) and /reset-password (author password reset) both
// draw from this same table, keyed by the same telegramId. Without this
// field a code minted for one flow could be redeemed by the other (OTP
// scope confusion) — every read/burn of LoginCode filters on purpose too,
// see implementation_plan.md §3.5/§3.6.
enum LoginCodePurpose {
  LOGIN
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Web / admin authentication — one-time login codes delivered via Telegram.
// Decoupled from the Mini App auth flow (which stays as telegramAuth).
// ---------------------------------------------------------------------------
model LoginCode {
  id         String @id @default(cuid())
  telegramId BigInt

  code      String
  expiresAt DateTime
  usedAt    DateTime?
  // Default LOGIN so every existing/pre-migration code (all minted by the
  // web-login OTP flow before password-reset existed) keeps working exactly
  // as before — see implementation_plan.md §10.
  purpose   LoginCodePurpose @default(LOGIN)

  createdAt DateTime @default(now())

  @@index([telegramId])
}

// ---------------------------------------------------------------------------
// Analytics — append-only telemetry. userId/patternId are stored as plain
// indexed scalars (no FK) so events survive user/pattern deletion and the
// existing User/Pattern models stay untouched.
// ---------------------------------------------------------------------------
model PatternView {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  // Откуда пришло событие: 'miniapp' (Telegram) или 'web' (браузер).
  // Nullable — события до появления браузерной версии платформы не знают,
  // все они фактически из Mini App (BROWSER_ACCESS_PLAN.md §4.5, P2).
  platform  String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model PatternLinkClick {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  // Откуда пришло событие: 'miniapp' (Telegram) или 'web' (браузер).
  // Nullable — события до появления браузерной версии платформы не знают,
  // все они фактически из Mini App (BROWSER_ACCESS_PLAN.md §4.5, P2).
  platform  String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model SubscribeClick {
  id        String   @id @default(uuid())
  userId    String
  // Откуда пришло событие: 'miniapp' (Telegram) или 'web' (браузер).
  // Nullable — события до появления браузерной версии платформы не знают,
  // все они фактически из Mini App (BROWSER_ACCESS_PLAN.md §4.5, P2).
  platform  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Append-only log, one row per logged search intent (not per keystroke —
// see triggers in Catalog.tsx: pagination scroll, click-through, or a 5s
// pause). query is normalized (trim + lowercase + collapsed whitespace)
// server-side so aggregation isn't case/whitespace-sensitive.
model SearchQuery {
  id           String   @id @default(uuid())
  userId       String
  query        String
  resultsCount Int
  // Откуда пришло событие: 'miniapp' (Telegram) или 'web' (браузер).
  // Nullable — события до появления браузерной версии платформы не знают,
  // все они фактически из Mini App (BROWSER_ACCESS_PLAN.md §4.5, P2).
  platform     String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([query, createdAt])
}

// ---------------------------------------------------------------------------
// Whitelist — users who bypass the subscription gate.
// telegramId is stored as BigInt to match the User model.
// createdBy stores the admin's userId as a plain string (no FK) so entries
// survive admin account deletions.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Bot chat — messages between admin and users via the support bot.
// ---------------------------------------------------------------------------
model AdminBotMessage {
  id         String   @id @default(uuid())
  telegramId BigInt
  text       String
  sentAt     DateTime @default(now())
  sentBy     String?

  @@index([telegramId])
  @@index([sentAt])
}

model BotInboundMessage {
  id          String   @id @default(uuid())
  telegramId  BigInt
  username    String?
  firstName   String?
  messageType String // text | sticker | photo | voice | video | document | other
  text        String?
  fileId      String?
  createdAt   DateTime @default(now())

  @@index([telegramId])
  @@index([createdAt])
}

model AdminChatState {
  id         String    @id @default(uuid())
  telegramId BigInt    @unique
  lastReadAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([telegramId])
