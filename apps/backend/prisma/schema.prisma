generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pattern {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  url             String
  imageUrl        String
  isFree          Boolean  @default(false)
  isNew           Boolean  @default(false)
  isVisible       Boolean  @default(true)
  densityStitches Int?
  densityRows     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  instruments Instrument[]
  categories  ProductType[]
  tags        Tag[]
  yarnRanges  YarnRange[]
  favoritedBy UserFavorite[]
  views       PatternView[]
  linkClicks  PatternLinkClick[]
  drafts      Draft[]
}

model Author {
  id       String    @id @default(uuid())
  name     String    @unique
  site     String?
  patterns Pattern[]
  drafts   Draft[]
  user     User?     @relation("UserAuthor")
}

model ProductType {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

model Instrument {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

// Fixed yarn-thickness buckets (m/100g), seeded — not user-creatable.
// sortOrder controls display order; maxValue is null for the open-ended top bucket ("701+").
model YarnRange {
  id        String    @id @default(uuid())
  label     String    @unique
  minValue  Int
  maxValue  Int?
  sortOrder Int       @default(0)
  patterns  Pattern[]
  drafts    Draft[]
}

enum UserRole {
  USER
  AUTHOR
  ADMIN
}

enum DraftStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum Permission {
  MINI_APP
  AUTHOR_CABINET
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  telegramId   BigInt   @unique
  firstName    String
  lastName     String?
  username     String?
  languageCode String?
  isPremium    Boolean  @default(false)
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastSeenAt   DateTime?
  platform     String?
  tgVersion    String?
  userAgent    String?

  favorites         UserFavorite[]
  patternViews      PatternView[]
  patternLinkClicks PatternLinkClick[]
  subscribeClicks   SubscribeClick[]

  authorId      String?  @unique
  author        Author?  @relation("UserAuthor", fields: [authorId], references: [id])
  permissions   UserPermission[]
  closedDrafts  Draft[]  @relation("DraftClosedBy")
  refreshTokens RefreshToken[]
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([userId, patternId])
}

// ---------------------------------------------------------------------------
// Web / admin authentication — one-time login codes delivered via Telegram.
// Decoupled from the Mini App auth flow (which stays as telegramAuth).
// ---------------------------------------------------------------------------
model LoginCode {
  id         String    @id @default(cuid())
  telegramId BigInt

  code      String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([telegramId])
}

// ---------------------------------------------------------------------------
// Analytics — append-only telemetry. userId/patternId are stored as plain
// indexed scalars (no FK) so events survive user/pattern deletion and the
// existing User/Pattern models stay untouched.
// ---------------------------------------------------------------------------
model PatternView {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model PatternLinkClick {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model SubscribeClick {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Whitelist — users who bypass the subscription gate.
// telegramId is stored as BigInt to match the User model.
// createdBy stores the admin's userId as a plain string (no FK) so entries
// survive admin account deletions.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Bot chat — messages between admin and users via the support bot.
// ---------------------------------------------------------------------------
model AdminBotMessage {
  id         String   @id @default(uuid())
  telegramId BigInt
  text       String
  sentAt     DateTime @default(now())
  sentBy     String?

  @@index([telegramId])
  @@index([sentAt])
}

model BotInboundMessage {
  id          String   @id @default(uuid())
  telegramId  BigInt
  username    String?
  firstName   String?
  messageType String   // text | sticker | photo | voice | video | document | other
  text        String?
  fileId      String?
  createdAt   DateTime @default(now())

  @@index([telegramId])
  @@index([createdAt])
}

model AdminChatState {
  id         String    @id @default(uuid())
  telegramId BigInt    @unique
  lastReadAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([telegramId])
}

model WhitelistedUser {
  id           String   @id @default(uuid())
  telegramId   BigInt   @unique
  username     String?
  firstName    String?
  lastName     String?
  comment      String?
  forceAllow                   Boolean   @default(false)
  debugLogging                 Boolean   @default(false)
  needsInvestigation           Boolean   @default(false)
  contactedViaBot              Boolean   @default(false)
  lastWhitelistAuthorizationAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
}

// ---------------------------------------------------------------------------
// Web auth — hashed refresh tokens for httpOnly-cookie rotation.
// The raw JWT is never stored; only its SHA-256 digest is persisted.
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Author cabinet — granular permissions per user.
// ---------------------------------------------------------------------------
model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission

  @@unique([userId, permission])
}

// ---------------------------------------------------------------------------
// Draft — proposed create or edit of a Pattern by a linked author.
//
// patternId = null  → new pattern proposal
// patternId ≠ null  → edit of an existing published pattern
//
// At most one *active* draft per pattern is enforced in application code.
// The DB-level guarantee requires a partial unique index that Prisma cannot
// express in schema syntax; add it manually to the generated migration SQL:
//
//   CREATE UNIQUE INDEX "Draft_active_patternId_key"
//     ON "Draft"("patternId")
//     WHERE "closedAt" IS NULL AND "patternId" IS NOT NULL;
//
// Closed drafts (closedAt IS NOT NULL) are retained as audit log.
// ---------------------------------------------------------------------------
model Draft {
  id                String      @id @default(uuid())
  patternId         String?
  pattern           Pattern?    @relation(fields: [patternId], references: [id])
  authorId          String
  author            Author      @relation(fields: [authorId], references: [id])
  status            DraftStatus @default(DRAFT)
  moderationComment String?
  title             String
  url               String
  imageUrl          String
  isFree            Boolean     @default(false)
  isNew             Boolean     @default(false)
  densityStitches   Int?
  densityRows       Int?
  closedAt          DateTime?
  closedById        String?
  closedBy          User?       @relation("DraftClosedBy", fields: [closedById], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tags        Tag[]
  categories  ProductType[]
  instruments Instrument[]
  yarnRanges  YarnRange[]

  @@index([patternId])
  @@index([authorId])
  @@index([status])
}
