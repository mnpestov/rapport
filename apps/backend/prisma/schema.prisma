generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pattern {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  url             String
  // Derived — always kept equal to images[0] by the backend on every write.
  // Never edited directly; exists because every "just the cover" read site
  // (catalog card, admin list/grid views, novelty cards) needs a plain
  // required string, not an array.
  imageUrl        String
  // Small (≤800px) derivative of images[0], for card/list contexts only
  // (catalog card, admin list/grid). Nullable — old rows are backfilled
  // gradually by the image-gallery backfill process, not in one migration;
  // every read site must fall back to imageUrl when this is null. NEVER
  // read on the pattern detail page — imageUrl (not this field) is what
  // non-premium users see there when `images` is empty, so imageUrl must
  // stay full quality, not this one.
  thumbnailUrl    String?
  images          String[]  @default([])
  // Long-form free text ("Подробности"), shown collapsed by default on the
  // detail page. Nullable (not "") so an empty/never-set block can be
  // omitted from the UI entirely via a plain truthy check. Will eventually
  // be populated by author_sync.py — see processSyncBatch's parsedData
  // fallback, already written to tolerate the key being absent today.
  details         String?
  // Absolute rubles, not a stored discount %/flag — oldPrice > price IS the
  // "discount active" signal, computed on display. Avoids the two numbers
  // going out of sync if only one gets edited later.
  price           Decimal?  @db.Decimal(10, 2)
  oldPrice        Decimal?  @db.Decimal(10, 2)
  isFree          Boolean   @default(false)
  isNew           Boolean   @default(false)
  isVisible       Boolean   @default(true)
  // Set once, the first time isVisible ever transitions to true — the actual
  // "went live" moment. Never touched again by later edits/re-hides, unlike
  // createdAt which for archive-queued sync items (isVisible: false at
  // creation) can predate real publication by however long it sits in
  // review. Anchor for the isNew auto-expiry job (see src/jobs).
  publishedAt     DateTime?
  densityStitches Decimal?  @db.Decimal(5, 2)
  densityRows     Decimal?  @db.Decimal(5, 2)
  // Оценка популярности для сортировки «Популярные». НЕ счётчик избранного:
  // сырые счётчики измеряют показы, а не интерес — бесплатных в каталоге
  // 2.9%, но им показывают в 6.7 раза больше, и по сырому избранному они
  // занимали весь топ-10. Здесь — доля открывших, которые сделали что-то
  // значимое (перешли к автору или добавили в избранное), сглаженная по
  // объёму. Считается фоновой задачей раз в сутки (src/jobs/popularity.ts),
  // а не запросом: агрегат по трём логам событий на каждую страницу
  // каталога не потянуть, да и балл не должен меняться в середине
  // прокрутки — иначе пагинация начнёт дублировать карточки.
  popularityScore Float     @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authorId     String
  author       Author               @relation(fields: [authorId], references: [id])
  instruments  Instrument[]
  categories   ProductType[]
  tags         Tag[]
  yarnRanges   YarnRange[]
  favoritedBy  UserFavorite[]
  views        PatternView[]
  linkClicks   PatternLinkClick[]
  drafts       Draft[]
  yarns        PatternYarn[]
  yarnMentions PatternYarnMention[]

  @@index([popularityScore, id])
}

model Author {
  id          String             @id @default(uuid())
  name        String             @unique
  site        String?
  patterns    Pattern[]
  drafts      Draft[]
  syncReports AuthorSyncReport[]
  user        User?              @relation("UserAuthor")
}

model ProductType {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

model Instrument {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

// Fixed yarn-thickness buckets (m/100g), seeded — not user-creatable.
// sortOrder controls display order; maxValue is null for the open-ended top bucket ("701+").
model YarnRange {
  id        String    @id @default(uuid())
  label     String    @unique
  minValue  Int
  maxValue  Int?
  sortOrder Int       @default(0)
  patterns  Pattern[]
  drafts    Draft[]
}

// ─── Артикулы пряжи ────────────────────────────────────────────────────────
// Отдельная сущность, а не поле у Pattern: на описание приходится в среднем
// 2,7 артикула, и одно поле выбросило бы больше половины связей. С YarnRange
// не пересекается и его не заменяет — YarnRange это диапазон метража, по
// которому идёт фильтр каталога, а здесь конкретная пряжа с именем.
model Yarn {
  id            String  @id @default(uuid())
  brand         String?
  line          String?
  // Полное «бренд + линейка» — то, что видит человек и по чему идёт поиск.
  name          String
  // Ключ сравнения: NFKC -> буквы-двойники -> нижний регистр -> выброс
  // «concept»/«by» -> транслитерация -> только буквы и цифры. Транслитерация
  // обязательна: авторы пишут «ализе» и «Alize» вперемешку.
  normalizedKey String  @unique
  // Отсортированное МНОЖЕСТВО нормализованных слов. Множество, а не
  // мультимножество: схлопывает и переставленный порядок («Baby Cotton XL» /
  // «Baby XL Cotton»), и задвоенный бренд («Infinity Design Design Air»).
  // Не уникален — служит для поиска дублей, а не для их запрета.
  dedupKey      String
  // Родовое название без марки: «Пух норки», «Эко-норка». У таких brand
  // совпадает с name, а line пуст — это свойство, а не пробел в данных.
  // Флаг нужен админке (не требовать бренд) и сопоставлению: родовые
  // обрабатываются последним правилом, и правило уровня бренда обязано их
  // пропускать, иначе перехватывает раньше.
  isGeneric     Boolean @default(false)

  // Характеристики — все необязательные: у трети карточек их нет вовсе.
  // Сырая строка и разобранные числа лежат рядом намеренно: строка нужна
  // человеку («4,5—5 мм»), числа — фильтрам. Тот же приём, что у
  // Pattern.densityStitches/densityRows.
  mPer100g        Int?
  composition     String?
  needleSizeRaw   String?
  needleMinMm     Float?
  needleMaxMm     Float?
  densityRaw      String?
  densityStitches Int?
  densityRows     Int?
  ballWeightG     Int?
  ballLengthM     Int?

  sourceName   String?
  sourceUrl    String?
  isActive     Boolean    @default(true)
  // PENDING — создан автором через POST /author/yarns, ждёт проверки, не
  // виден в suggestYarns. APPROVED — прошёл проверку (или создан админом
  // через POST /admin/yarns — default), виден в справочнике как сейчас.
  // Не путать с YarnMentionStatus — тоже использует PENDING, но для
  // PatternYarnMention, не связанная модель.
  status       YarnStatus @default(APPROVED)
  // При слиянии дублей карточка не удаляется, а помечается ссылкой на
  // победителя: связи на неё уже могли разойтись по описаниям, и удаление
  // порвало бы их.
  mergedIntoId String?
  mergedInto   Yarn?   @relation("YarnMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Yarn[]  @relation("YarnMerge")

  aliases      YarnAlias[]
  patterns     PatternYarn[]
  drafts       DraftYarn[]
  suggestedFor PatternYarnMention[] @relation("YarnSuggested")
  resolvedFor  PatternYarnMention[] @relation("YarnResolved")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dedupKey])
  @@index([brand])
  @@index([status])
}

// Как пряжу пишут люди: опечатки («Lana Gossa»), транслитерации («Сеам»),
// авторские написания, а также цветовые варианты, схлопнутые при чистке
// («Rico Design Essentials Cotton DK banana 63»). Поиск смотрит и сюда, и в
// Yarn.normalizedKey.
model YarnAlias {
  id              String @id @default(uuid())
  yarnId          String
  yarn            Yarn   @relation(fields: [yarnId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String @unique

  createdAt DateTime @default(now())

  @@index([yarnId])
}

enum YarnStatus {
  PENDING
  APPROVED
}

enum YarnLinkSource {
  SCRAPER
  ADMIN
  BACKFILL
}

enum YarnLinkStatus {
  ACTIVE
  // «Человек удалил, не создавать заново». Без этого статуса перезапуск
  // бэкофила воскрешал бы связь: текст описания не менялся, разбор даст тот
  // же результат, и модератор удалял бы одно и то же по кругу.
  REJECTED
}

enum YarnMatchRule {
  EXACT
  // Автор ошибся в написании, и человек сверил, что он имел в виду.
  // Соответствия лежат в yarn_lib/corrections.py — это знание разбора, а не
  // свойство пряжи, поэтому в справочник опечатка не попадает.
  CORRECTION
  PARTIAL
  SHORT_FORM
  FAMILY
  LINE_NAME
  BRAND_LEVEL
  AUTHOR_METRAGE
  GENERIC
  MANUAL
}

// Связь «описание ↔ артикул». Роли (оригинал/альтернатива) у связи нет
// сознательно: цель — понять, из какой пряжи это изделие уже вязали, и обе
// роли отвечают на вопрос одинаково.
model PatternYarn {
  id        String  @id @default(uuid())
  patternId String
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  yarnId    String
  yarn      Yarn    @relation(fields: [yarnId], references: [id])

  // Как пряжа названа в тексте описания, дословно, и метраж оттуда же.
  // Метраж хранится здесь, а не переносится в Pattern.yarnRanges: это
  // авторский текст, мы его не меняем.
  rawMention    String?
  metrageInText String?

  source      YarnLinkSource
  status      YarnLinkStatus @default(ACTIVE)
  matchRule   YarnMatchRule?
  // Отпечаток details, с которого связь собрана. Правка описания в админке
  // связи не трогает, и без отпечатка расхождение больше негде заметить.
  detailsHash String?

  createdAt DateTime @default(now())

  @@unique([patternId, yarnId])
  @@index([patternId])
  @@index([yarnId])
}

enum YarnMentionKind {
  // «Meilenweit», «Merino Extrafine» — уровень семейства: карточка семейства
  // склеила бы нити разной толщины и сломала поиск.
  FAMILY
  // Названа только марка. Для «Katia» никакое пополнение справочника не
  // поможет — у бренда десятки линеек, и какая имелась в виду, не следует.
  BRAND_ONLY
  UNKNOWN_ARTICLE
}

enum YarnMentionStatus {
  PENDING
  RESOLVED
  REJECTED
}

// Упоминание пряжи, из которого связь не собралась. Данные не выбрасываем:
// по этой таблице строится рабочий список на пополнение справочника.
model PatternYarnMention {
  id        String  @id @default(uuid())
  patternId String
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  rawText         String
  metrageInText   String?
  kind            YarnMentionKind
  // Кандидат, предложенный правилом, у которого не хватило уверенности на
  // связь: «по названию линейки» даёт 36% точности, поэтому оно пишет
  // подсказку сюда, а не связь.
  suggestedYarnId String?
  suggestedYarn   Yarn?           @relation("YarnSuggested", fields: [suggestedYarnId], references: [id])
  matchRule       YarnMatchRule?
  resolvedYarnId  String?
  resolvedYarn    Yarn?           @relation("YarnResolved", fields: [resolvedYarnId], references: [id])

  status      YarnMentionStatus @default(PENDING)
  detailsHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Одно и то же название в одном описании — одно упоминание. Без этого
  // перезапуск бэкофила плодил бы копии, а решение модератора по одной из
  // них не распространялось бы на остальные.
  @@unique([patternId, rawText])
  @@index([patternId])
  @@index([status])
}

enum UserRole {
  USER
  AUTHOR
  ADMIN
}

enum DraftStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum Permission {
  MINI_APP
  AUTHOR_CABINET
  ADMIN
  PREMIUM_CORE
  PREMIUM_EXTRA
  PREMIUM_DETAILS
}

// Что именно произошло с баннером подписки. Append-only лог событий, из
// которого строится воронка (PAYMENTS_ROBOKASSA_PLAN.md §10).
// Хранить это в User.lastPaywallShownAt нельзя: то поле перезаписывается и
// на нём висит функциональный 7-дневный кулдаун показа.
enum PaywallEventType {
  SHOWN // баннер открылся
  SCROLLED_TO_END // долистал список функций до конца
  SUBSCRIBE_CLICK // нажал "Оформить подписку" / "Продлить"
  CLOSED // закрыл — кнопкой или тапом по затемнению, не различаем
  BUTTON_OPENED // открыл шторку кнопкой в строке поиска
}

// Откуда открылась шторка. Нужен и на событии, и на Payment: без источника
// нельзя ответить, окупается ли кнопка у поиска и работают ли напоминания.
// Задним числом не восстанавливается — единственная часть аналитики,
// которую нельзя отложить (§10.3, §10.7).
enum PaywallSource {
  AUTO_BANNER // автопоказ при входе
  SEARCH_BUTTON // кнопка подписки в строке поиска
  FILTER_LOCK // тап по платной секции в шторке фильтров
  EXPIRING_3_DAYS // предупреждение "истекает через 3 дня"
  EXPIRING_1_DAY // предупреждение "через 1 день"
  ACTIVE // шторка "подписка активна" (продление из неё)
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id           String    @id @default(uuid())
  telegramId   BigInt    @unique
  firstName    String
  lastName     String?
  username     String?
  languageCode String?
  isPremium    Boolean   @default(false)
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime?
  platform     String?
  tgVersion    String?
  userAgent    String?

  // Paywall banner "1 in 7 days" gate — see PAYWALL_BANNER_PLAN.md §3.
  // lastPaywallClickedAt is not read anywhere yet, kept purely for future
  // conversion analytics (cheaper to add now than in a second migration).
  lastPaywallShownAt   DateTime?
  lastPaywallClickedAt DateTime?

  // Свои и тестовые аккаунты, которых не должно быть в статистике воронки
  // подписки (PAYMENTS_ROBOKASSA_PLAN.md §10). Отдельный флаг, а не роль:
  // "кто управляет системой" и "чья активность — тестовый шум" — разные
  // вещи, и помечать тестировщика не должно означать выдачу ему прав
  // админа. Переключается в карточке пользователя в админке.
  //
  // Сейчас влияет только на воронку подписки: основная статистика
  // дашборда (просмотры, переходы, топы) флаг не учитывает.
  excludeFromStats Boolean @default(false)

  // Paid subscription (Robokassa) — see PAYMENTS_ROBOKASSA_PLAN.md §5.2.
  // Denormalized the same way as Pattern.imageUrl: the only reader is the
  // daily reminder/revoke cron job. Access itself is still decided purely
  // by UserPermission (resolveRole, /auth/telegram permissions[], admin UI)
  // — nothing else needs to know this field exists.
  premiumExpiresAt DateTime?

  // Когда ушло напоминание "подписка заканчивается через 3 дня" за текущий
  // оплаченный период. Без этого поля cron слал бы его каждые сутки все
  // три дня подряд — окно "истекает в ближайшие 3 дня" совпадает при каждом
  // прогоне. Сбрасывается в null при каждой новой оплате, чтобы следующий
  // период снова получил своё напоминание (paymentsController.ts).
  premiumReminderSentAt DateTime?

  favorites         UserFavorite[]
  patternViews      PatternView[]
  patternLinkClicks PatternLinkClick[]
  subscribeClicks   SubscribeClick[]
  searchQueries     SearchQuery[]
  payments          Payment[]
  paywallEvents     PaywallEvent[]

  authorId      String?          @unique
  author        Author?          @relation("UserAuthor", fields: [authorId], references: [id])
  permissions   UserPermission[]
  closedDrafts  Draft[]          @relation("DraftClosedBy")
  refreshTokens RefreshToken[]

  authorApplications AuthorApplication[]
  credential         UserCredential?
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([userId, patternId])
  // Составной unique выше начинается с userId и для группировки по
  // patternId бесполезен — а именно она нужна сортировке «Популярные»
  // (orderBy favoritedBy._count) и топам в админке.
  @@index([patternId])
}

// Which flow a LoginCode was issued for — webAuthController's /verify-code
// (web/admin OTP login) and /reset-password (author password reset) both
// draw from this same table, keyed by the same telegramId. Without this
// field a code minted for one flow could be redeemed by the other (OTP
// scope confusion) — every read/burn of LoginCode filters on purpose too,
// see implementation_plan.md §3.5/§3.6.
enum LoginCodePurpose {
  LOGIN
  PASSWORD_RESET
}

// ---------------------------------------------------------------------------
// Web / admin authentication — one-time login codes delivered via Telegram.
// Decoupled from the Mini App auth flow (which stays as telegramAuth).
// ---------------------------------------------------------------------------
model LoginCode {
  id         String @id @default(cuid())
  telegramId BigInt

  code      String
  expiresAt DateTime
  usedAt    DateTime?
  // Default LOGIN so every existing/pre-migration code (all minted by the
  // web-login OTP flow before password-reset existed) keeps working exactly
  // as before — see implementation_plan.md §10.
  purpose   LoginCodePurpose @default(LOGIN)

  createdAt DateTime @default(now())

  @@index([telegramId])
}

// ---------------------------------------------------------------------------
// Analytics — append-only telemetry. userId/patternId are stored as plain
// indexed scalars (no FK) so events survive user/pattern deletion and the
// existing User/Pattern models stay untouched.
// ---------------------------------------------------------------------------
model PatternView {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model PatternLinkClick {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model SubscribeClick {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Append-only log, one row per logged search intent (not per keystroke —
// see triggers in Catalog.tsx: pagination scroll, click-through, or a 5s
// pause). query is normalized (trim + lowercase + collapsed whitespace)
// server-side so aggregation isn't case/whitespace-sensitive.
model SearchQuery {
  id           String   @id @default(uuid())
  userId       String
  query        String
  resultsCount Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([query, createdAt])
}

// ---------------------------------------------------------------------------
// Whitelist — users who bypass the subscription gate.
// telegramId is stored as BigInt to match the User model.
// createdBy stores the admin's userId as a plain string (no FK) so entries
// survive admin account deletions.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Bot chat — messages between admin and users via the support bot.
// ---------------------------------------------------------------------------
model AdminBotMessage {
  id         String   @id @default(uuid())
  telegramId BigInt
  text       String
  sentAt     DateTime @default(now())
  sentBy     String?

  @@index([telegramId])
  @@index([sentAt])
}

model BotInboundMessage {
  id          String   @id @default(uuid())
  telegramId  BigInt
  username    String?
  firstName   String?
  messageType String // text | sticker | photo | voice | video | document | other
  text        String?
  fileId      String?
  createdAt   DateTime @default(now())

  @@index([telegramId])
  @@index([createdAt])
}

model AdminChatState {
  id         String    @id @default(uuid())
  telegramId BigInt    @unique
  lastReadAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([telegramId])
}

model WhitelistedUser {
  id                           String    @id @default(uuid())
  telegramId                   BigInt    @unique
  username                     String?
  firstName                    String?
  lastName                     String?
  comment                      String?
  forceAllow                   Boolean   @default(false)
  debugLogging                 Boolean   @default(false)
  needsInvestigation           Boolean   @default(false)
  contactedViaBot              Boolean   @default(false)
  lastWhitelistAuthorizationAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  createdBy                    String?
}

// ---------------------------------------------------------------------------
// Web auth — hashed refresh tokens for httpOnly-cookie rotation.
// The raw JWT is never stored; only its SHA-256 digest is persisted.
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Status of a regular user's request to become an author (login/password +
// AuthorApplication implementation_plan.md). Submitted from the mini app or
// the support bot, reviewed by an admin.
enum ApplicationStatus {
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// A user's request to become an author. At most one PENDING application per
// user — enforced by a partial unique index Prisma can't express in schema
// syntax; add it manually to the generated migration SQL (same pattern as
// Draft_active_patternId_key below):
//
//   CREATE UNIQUE INDEX "AuthorApplication_pending_userId_key"
//     ON "AuthorApplication"("userId")
//     WHERE status = 'PENDING';
//
// NEEDS_INFO and REJECTED applications are NOT covered by that index (the
// user can freely resubmit once out of NEEDS_INFO, and REJECTED has its own
// 24h cooldown enforced in application code via processedAt, not the DB) —
// only one application can ever be "awaiting a decision" at a time.
// ---------------------------------------------------------------------------
model AuthorApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  authorName String   @db.VarChar(120)
  // Max 10 URLs, each max 500 chars — enforced in authorApplicationController,
  // not at the DB level (Postgres text[] has no per-element length constraint).
  resources  String[]

  status ApplicationStatus @default(PENDING)
  // Set by an admin on needs-info/reject; explains what's missing or why.
  adminComment String?
  // The applicant's free-text reply to adminComment, submitted via the bot's
  // "Ответить" flow (see /internal/bot/author-application/respond). Overwritten
  // on each reply — no history kept; a second NEEDS_INFO round on the same
  // application clobbers the previous response, which is an accepted gap for
  // now (rare case).
  userResponse String?

  // Who/when this application was last moved out of PENDING/NEEDS_INFO.
  // processedAt (not updatedAt) anchors the 24h reapply cooldown after
  // REJECTED — updatedAt would also move on an unrelated adminComment edit.
  processedById String?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Login/password credentials for web access — an alternative to the Telegram
// OTP flow (webAuthController.ts), not a replacement. Both lead to the same
// User. One credential per user (1:1, enforced by userId @unique below).
//
// Раньше называлась AuthorCredential и обслуживала только авторский кабинет.
// Переименована при вводе браузерного доступа (BROWSER_ACCESS_PLAN.md §3.1,
// решение A1): учётка для входа и доступ в кабинет — разные вещи. Кабинет —
// это Permission.AUTHOR_CABINET ПОВЕРХ обычной учётки, а не отдельный вид
// учётки; они были склеены исторически. Сама модель не изменилась, только имя.
// ---------------------------------------------------------------------------
model UserCredential {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Хранится ВСЕГДА в нижнем регистре — нормализация на запись во всех
  // контроллерах (BROWSER_ACCESS_PLAN.md §4.1). У авторских логинов это было
  // не важно (машинный slug всегда lowercase), но пользователь придумывает
  // логин сам, и без нормализации "Masha"/"masha" стали бы двумя аккаунтами.
  // Max 60 chars (see generateSlug in utils/slug.ts + resolveUniqueLogin).
  login        String @unique
  passwordHash String

  // True on every credential issuance (approve, direct grant, resend) —
  // forces a change before the temp password can be used for anything past
  // /change-password. See implementation_plan.md §3.2 step 8.
  mustChangePassword Boolean @default(true)
  // Set after MAX_LOGIN_ATTEMPTS consecutive failures; cleared on success or
  // on a password change/reset. Not the same as a permanent ban — this is a
  // rolling lockout window (see webAuthController.ts's LOGIN_LOCK_MS).
  lockedUntil DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  // Admin userId who issued this credential (approve or direct grant) —
  // audit trail only, no FK (admin accounts can be deleted independently).
  // Nullable и для self-serve: когда учётку создаёт сам пользователь через
  // бота, выдавшего админа нет.
  createdById String?
}

// ---------------------------------------------------------------------------
// Author cabinet — granular permissions per user.
// ---------------------------------------------------------------------------
model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission

  @@unique([userId, permission])
}

// ---------------------------------------------------------------------------
// Draft — proposed create or edit of a Pattern by a linked author.
//
// patternId = null  → new pattern proposal
// patternId ≠ null  → edit of an existing published pattern
//
// At most one *active* draft per pattern is enforced in application code.
// The DB-level guarantee requires a partial unique index that Prisma cannot
// express in schema syntax; add it manually to the generated migration SQL:
//
//   CREATE UNIQUE INDEX "Draft_active_patternId_key"
//     ON "Draft"("patternId")
//     WHERE "closedAt" IS NULL AND "patternId" IS NOT NULL;
//
// Closed drafts (closedAt IS NOT NULL) are retained as audit log.
// ---------------------------------------------------------------------------
model Draft {
  id                String      @id @default(uuid())
  patternId         String?
  pattern           Pattern?    @relation(fields: [patternId], references: [id])
  authorId          String
  author            Author      @relation(fields: [authorId], references: [id])
  status            DraftStatus @default(DRAFT)
  moderationComment String?
  title             String
  url               String
  imageUrl          String
  // Same role/derivation as Pattern.thumbnailUrl — see the comment there.
  thumbnailUrl      String?
  images            String[]    @default([])
  details           String?
  price             Decimal?    @db.Decimal(10, 2)
  oldPrice          Decimal?    @db.Decimal(10, 2)
  isFree            Boolean     @default(false)
  isNew             Boolean     @default(false)
  densityStitches   Decimal?    @db.Decimal(5, 2)
  densityRows       Decimal?    @db.Decimal(5, 2)
  closedAt          DateTime?
  closedById        String?
  closedBy          User?       @relation("DraftClosedBy", fields: [closedById], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tags        Tag[]
  categories  ProductType[]
  instruments Instrument[]
  yarnRanges  YarnRange[]
  yarns       DraftYarn[]

  @@index([patternId])
  @@index([authorId])
  @@index([status])
}

// Артикулы пряжи, выбранные автором в форме черновика — до approveDraft это
// живёт отдельно от PatternYarn (которая существует только у опубликованного
// Pattern). Упрощённая версия PatternYarn: нет source/matchRule/rawMention —
// это всегда ручной выбор автора через YarnPicker, не результат разбора
// скрапером/бэкофилом, разбирать тут нечего.
model DraftYarn {
  id      String @id @default(uuid())
  draftId String
  draft   Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  yarnId  String
  yarn    Yarn   @relation(fields: [yarnId], references: [id])

  createdAt DateTime @default(now())

  @@unique([draftId, yarnId])
  @@index([draftId])
  @@index([yarnId])
}

// ---------------------------------------------------------------------------
// Author Sync — auto-sync feature for parsing author sites
// ---------------------------------------------------------------------------
enum AuthorSyncReportStatus {
  PENDING
  PROCESSED
}

enum AuthorSyncItemStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuthorSyncReport {
  id        String                 @id @default(uuid())
  authorId  String
  author    Author                 @relation(fields: [authorId], references: [id])
  status    AuthorSyncReportStatus @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  items AuthorSyncItem[]

  @@index([status])
}

model AuthorSyncItem {
  id         String               @id @default(uuid())
  reportId   String
  report     AuthorSyncReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status     AuthorSyncItemStatus @default(PENDING)
  url        String
  title      String
  parsedData Json

  @@unique([reportId, url])
  @@index([reportId])
}

// One row per check_price_updates.py run (cron, twice daily — see
// DETAILS_PRICE_PARSING_PROCESS.md). Written directly by the Python script
// via psycopg2 (same pattern as the rest of that pipeline — raw SQL, not
// through this Node app), read by the admin "Справочник" page. Telegram
// only fires when errorsCount > 0; a clean run is visible ONLY here.
model PriceCheckRun {
  id          String   @id @default(uuid())
  startedAt   DateTime
  finishedAt  DateTime
  checked     Int
  changed     Int
  errorsCount Int
  // Arrays of {author, title, url, oldPrice, oldOldPrice, newPrice, newOldPrice}
  // and {author, url, error} — same shape as check_price_updates.py's
  // in-memory `changes`/`errors` lists, just serialized.
  changes     Json
  errors      Json
  // {author, url, nights}[] — patterns that hit ESCALATION_THRESHOLD this
  // run (see price_check_state.json). Empty most runs.
  escalations Json
  createdAt   DateTime @default(now())

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Robokassa payments — plain history/accounting, does NOT participate in
// access logic (see PAYMENTS_ROBOKASSA_PLAN.md §5.1). Access is decided by
// UserPermission + User.premiumExpiresAt; this table exists so every charge
// has a record, a receipt-sent flag, and a numeric order id.
// invId is separate from id: Robokassa requires a plain numeric InvId, not
// a UUID, so it gets its own autoincrement column rather than reusing id.
// ---------------------------------------------------------------------------
model Payment {
  id            String         @id @default(uuid())
  invId         Int            @unique @default(autoincrement())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(10, 2)
  status        PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  paidAt        DateTime?
  // Set once the Robokassa-generated receipt has been sent to the user's
  // bot chat, so a Result URL retry doesn't send it twice.
  receiptSentAt DateTime?
  // Откуда пользователь пришёл к оплате. Nullable: платежи, созданные до
  // появления аналитики, источника не знают, и задним числом его не
  // вычислить. Заполняется при создании платежа из того, какая шторка была
  // открыта.
  source        PaywallSource?

  @@index([userId])
  // Для воронки и статистики продлений: выборки всегда по периоду
  // (createdAt/paidAt) — см. §10.
  @@index([status, paidAt])
}

// Append-only лог событий баннера подписки — по образцу PatternView/
// SearchQuery. Одна строка на событие; воронка считается по УНИКАЛЬНЫМ
// пользователям за период, а не по числу строк: один человек видит баннер
// ~4 раза в месяц, и смешение оснований занизило бы конверсию (§10.2).
model PaywallEvent {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PaywallEventType
  source    PaywallSource
  createdAt DateTime         @default(now())

  // Воронка группирует по (type, source) в границах периода — этим
  // индексом и читается.
  @@index([createdAt, type, source])
  @@index([userId])
}
