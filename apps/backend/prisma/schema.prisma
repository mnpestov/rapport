generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pattern {
  id              String    @id @default(uuid())
  slug            String    @unique
  title           String
  url             String
  // Derived — always kept equal to images[0] by the backend on every write.
  // Never edited directly; exists because every "just the cover" read site
  // (catalog card, admin list/grid views, novelty cards) needs a plain
  // required string, not an array.
  imageUrl        String
  // Small (≤800px) derivative of images[0], for card/list contexts only
  // (catalog card, admin list/grid). Nullable — old rows are backfilled
  // gradually by the image-gallery backfill process, not in one migration;
  // every read site must fall back to imageUrl when this is null. NEVER
  // read on the pattern detail page — imageUrl (not this field) is what
  // non-premium users see there when `images` is empty, so imageUrl must
  // stay full quality, not this one.
  thumbnailUrl    String?
  images          String[]  @default([])
  // Long-form free text ("Подробности"), shown collapsed by default on the
  // detail page. Nullable (not "") so an empty/never-set block can be
  // omitted from the UI entirely via a plain truthy check. Will eventually
  // be populated by author_sync.py — see processSyncBatch's parsedData
  // fallback, already written to tolerate the key being absent today.
  details         String?
  // Absolute rubles, not a stored discount %/flag — oldPrice > price IS the
  // "discount active" signal, computed on display. Avoids the two numbers
  // going out of sync if only one gets edited later.
  price           Decimal?  @db.Decimal(10, 2)
  oldPrice        Decimal?  @db.Decimal(10, 2)
  isFree          Boolean   @default(false)
  isNew           Boolean   @default(false)
  isVisible       Boolean   @default(true)
  // Set once, the first time isVisible ever transitions to true — the actual
  // "went live" moment. Never touched again by later edits/re-hides, unlike
  // createdAt which for archive-queued sync items (isVisible: false at
  // creation) can predate real publication by however long it sits in
  // review. Anchor for the isNew auto-expiry job (see src/jobs).
  publishedAt     DateTime?
  densityStitches Decimal?  @db.Decimal(5, 2)
  densityRows     Decimal?  @db.Decimal(5, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authorId String
  author   Author @relation(fields: [authorId], references: [id])

  instruments Instrument[]
  categories  ProductType[]
  tags        Tag[]
  yarnRanges  YarnRange[]
  favoritedBy UserFavorite[]
  views       PatternView[]
  linkClicks  PatternLinkClick[]
  drafts      Draft[]
}

model Author {
  id          String             @id @default(uuid())
  name        String             @unique
  site        String?
  patterns    Pattern[]
  drafts      Draft[]
  syncReports AuthorSyncReport[]
  user        User?              @relation("UserAuthor")
}

model ProductType {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

model Instrument {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  patterns Pattern[]
  drafts   Draft[]
}

// Fixed yarn-thickness buckets (m/100g), seeded — not user-creatable.
// sortOrder controls display order; maxValue is null for the open-ended top bucket ("701+").
model YarnRange {
  id        String    @id @default(uuid())
  label     String    @unique
  minValue  Int
  maxValue  Int?
  sortOrder Int       @default(0)
  patterns  Pattern[]
  drafts    Draft[]
}

enum UserRole {
  USER
  AUTHOR
  ADMIN
}

enum DraftStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum Permission {
  MINI_APP
  AUTHOR_CABINET
  ADMIN
  PREMIUM_CORE
  PREMIUM_EXTRA
  PREMIUM_DETAILS
}

enum PaymentStatus {
  PENDING
  PAID
}

model User {
  id           String    @id @default(uuid())
  telegramId   BigInt    @unique
  firstName    String
  lastName     String?
  username     String?
  languageCode String?
  isPremium    Boolean   @default(false)
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastSeenAt   DateTime?
  platform     String?
  tgVersion    String?
  userAgent    String?

  // Paywall banner "1 in 7 days" gate — see PAYWALL_BANNER_PLAN.md §3.
  // lastPaywallClickedAt is not read anywhere yet, kept purely for future
  // conversion analytics (cheaper to add now than in a second migration).
  lastPaywallShownAt   DateTime?
  lastPaywallClickedAt DateTime?

  // Paid subscription (Robokassa) — see PAYMENTS_ROBOKASSA_PLAN.md §5.2.
  // Denormalized the same way as Pattern.imageUrl: the only reader is the
  // daily reminder/revoke cron job. Access itself is still decided purely
  // by UserPermission (resolveRole, /auth/telegram permissions[], admin UI)
  // — nothing else needs to know this field exists.
  premiumExpiresAt DateTime?

  // Когда ушло напоминание "подписка заканчивается через 3 дня" за текущий
  // оплаченный период. Без этого поля cron слал бы его каждые сутки все
  // три дня подряд — окно "истекает в ближайшие 3 дня" совпадает при каждом
  // прогоне. Сбрасывается в null при каждой новой оплате, чтобы следующий
  // период снова получил своё напоминание (paymentsController.ts).
  premiumReminderSentAt DateTime?

  favorites         UserFavorite[]
  patternViews      PatternView[]
  patternLinkClicks PatternLinkClick[]
  subscribeClicks   SubscribeClick[]
  searchQueries     SearchQuery[]
  payments          Payment[]

  authorId      String?          @unique
  author        Author?          @relation("UserAuthor", fields: [authorId], references: [id])
  permissions   UserPermission[]
  closedDrafts  Draft[]          @relation("DraftClosedBy")
  refreshTokens RefreshToken[]
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@unique([userId, patternId])
}

// ---------------------------------------------------------------------------
// Web / admin authentication — one-time login codes delivered via Telegram.
// Decoupled from the Mini App auth flow (which stays as telegramAuth).
// ---------------------------------------------------------------------------
model LoginCode {
  id         String @id @default(cuid())
  telegramId BigInt

  code      String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([telegramId])
}

// ---------------------------------------------------------------------------
// Analytics — append-only telemetry. userId/patternId are stored as plain
// indexed scalars (no FK) so events survive user/pattern deletion and the
// existing User/Pattern models stay untouched.
// ---------------------------------------------------------------------------
model PatternView {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model PatternLinkClick {
  id        String   @id @default(uuid())
  userId    String
  patternId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([patternId])
}

model SubscribeClick {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Append-only log, one row per logged search intent (not per keystroke —
// see triggers in Catalog.tsx: pagination scroll, click-through, or a 5s
// pause). query is normalized (trim + lowercase + collapsed whitespace)
// server-side so aggregation isn't case/whitespace-sensitive.
model SearchQuery {
  id           String   @id @default(uuid())
  userId       String
  query        String
  resultsCount Int
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([query, createdAt])
}

// ---------------------------------------------------------------------------
// Whitelist — users who bypass the subscription gate.
// telegramId is stored as BigInt to match the User model.
// createdBy stores the admin's userId as a plain string (no FK) so entries
// survive admin account deletions.
// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Bot chat — messages between admin and users via the support bot.
// ---------------------------------------------------------------------------
model AdminBotMessage {
  id         String   @id @default(uuid())
  telegramId BigInt
  text       String
  sentAt     DateTime @default(now())
  sentBy     String?

  @@index([telegramId])
  @@index([sentAt])
}

model BotInboundMessage {
  id          String   @id @default(uuid())
  telegramId  BigInt
  username    String?
  firstName   String?
  messageType String // text | sticker | photo | voice | video | document | other
  text        String?
  fileId      String?
  createdAt   DateTime @default(now())

  @@index([telegramId])
  @@index([createdAt])
}

model AdminChatState {
  id         String    @id @default(uuid())
  telegramId BigInt    @unique
  lastReadAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([telegramId])
}

model WhitelistedUser {
  id                           String    @id @default(uuid())
  telegramId                   BigInt    @unique
  username                     String?
  firstName                    String?
  lastName                     String?
  comment                      String?
  forceAllow                   Boolean   @default(false)
  debugLogging                 Boolean   @default(false)
  needsInvestigation           Boolean   @default(false)
  contactedViaBot              Boolean   @default(false)
  lastWhitelistAuthorizationAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  createdBy                    String?
}

// ---------------------------------------------------------------------------
// Web auth — hashed refresh tokens for httpOnly-cookie rotation.
// The raw JWT is never stored; only its SHA-256 digest is persisted.
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Author cabinet — granular permissions per user.
// ---------------------------------------------------------------------------
model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission

  @@unique([userId, permission])
}

// ---------------------------------------------------------------------------
// Draft — proposed create or edit of a Pattern by a linked author.
//
// patternId = null  → new pattern proposal
// patternId ≠ null  → edit of an existing published pattern
//
// At most one *active* draft per pattern is enforced in application code.
// The DB-level guarantee requires a partial unique index that Prisma cannot
// express in schema syntax; add it manually to the generated migration SQL:
//
//   CREATE UNIQUE INDEX "Draft_active_patternId_key"
//     ON "Draft"("patternId")
//     WHERE "closedAt" IS NULL AND "patternId" IS NOT NULL;
//
// Closed drafts (closedAt IS NOT NULL) are retained as audit log.
// ---------------------------------------------------------------------------
model Draft {
  id                String      @id @default(uuid())
  patternId         String?
  pattern           Pattern?    @relation(fields: [patternId], references: [id])
  authorId          String
  author            Author      @relation(fields: [authorId], references: [id])
  status            DraftStatus @default(DRAFT)
  moderationComment String?
  title             String
  url               String
  imageUrl          String
  // Same role/derivation as Pattern.thumbnailUrl — see the comment there.
  thumbnailUrl      String?
  images            String[]    @default([])
  details           String?
  price             Decimal?    @db.Decimal(10, 2)
  oldPrice          Decimal?    @db.Decimal(10, 2)
  isFree            Boolean     @default(false)
  isNew             Boolean     @default(false)
  densityStitches   Decimal?    @db.Decimal(5, 2)
  densityRows       Decimal?    @db.Decimal(5, 2)
  closedAt          DateTime?
  closedById        String?
  closedBy          User?       @relation("DraftClosedBy", fields: [closedById], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tags        Tag[]
  categories  ProductType[]
  instruments Instrument[]
  yarnRanges  YarnRange[]

  @@index([patternId])
  @@index([authorId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Author Sync — auto-sync feature for parsing author sites
// ---------------------------------------------------------------------------
enum AuthorSyncReportStatus {
  PENDING
  PROCESSED
}

enum AuthorSyncItemStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuthorSyncReport {
  id        String                 @id @default(uuid())
  authorId  String
  author    Author                 @relation(fields: [authorId], references: [id])
  status    AuthorSyncReportStatus @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  items AuthorSyncItem[]

  @@index([status])
}

model AuthorSyncItem {
  id         String               @id @default(uuid())
  reportId   String
  report     AuthorSyncReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status     AuthorSyncItemStatus @default(PENDING)
  url        String
  title      String
  parsedData Json

  @@unique([reportId, url])
  @@index([reportId])
}

// One row per check_price_updates.py run (cron, twice daily — see
// DETAILS_PRICE_PARSING_PROCESS.md). Written directly by the Python script
// via psycopg2 (same pattern as the rest of that pipeline — raw SQL, not
// through this Node app), read by the admin "Справочник" page. Telegram
// only fires when errorsCount > 0; a clean run is visible ONLY here.
model PriceCheckRun {
  id          String   @id @default(uuid())
  startedAt   DateTime
  finishedAt  DateTime
  checked     Int
  changed     Int
  errorsCount Int
  // Arrays of {author, title, url, oldPrice, oldOldPrice, newPrice, newOldPrice}
  // and {author, url, error} — same shape as check_price_updates.py's
  // in-memory `changes`/`errors` lists, just serialized.
  changes     Json
  errors      Json
  // {author, url, nights}[] — patterns that hit ESCALATION_THRESHOLD this
  // run (see price_check_state.json). Empty most runs.
  escalations Json
  createdAt   DateTime @default(now())

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Robokassa payments — plain history/accounting, does NOT participate in
// access logic (see PAYMENTS_ROBOKASSA_PLAN.md §5.1). Access is decided by
// UserPermission + User.premiumExpiresAt; this table exists so every charge
// has a record, a receipt-sent flag, and a numeric order id.
// invId is separate from id: Robokassa requires a plain numeric InvId, not
// a UUID, so it gets its own autoincrement column rather than reusing id.
// ---------------------------------------------------------------------------
model Payment {
  id            String        @id @default(uuid())
  invId         Int           @unique @default(autoincrement())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  paidAt        DateTime?
  // Set once the Robokassa-generated receipt has been sent to the user's
  // bot chat, so a Result URL retry doesn't send it twice.
  receiptSentAt DateTime?

  @@index([userId])
}
