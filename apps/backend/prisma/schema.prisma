model WhitelistedUser {
  id                           String    @id @default(uuid())
  telegramId                   BigInt    @unique
  username                     String?
  firstName                    String?
  lastName                     String?
  comment                      String?
  forceAllow                   Boolean   @default(false)
  debugLogging                 Boolean   @default(false)
  needsInvestigation           Boolean   @default(false)
  contactedViaBot              Boolean   @default(false)
  lastWhitelistAuthorizationAt DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  createdBy                    String?
}

// ---------------------------------------------------------------------------
// Web auth — hashed refresh tokens for httpOnly-cookie rotation.
// The raw JWT is never stored; only its SHA-256 digest is persisted.
// ---------------------------------------------------------------------------
model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean   @default(false)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Веб-сессия, внутри которой этот токен ротируется (BROWSER_ACCESS_PLAN.md
  // §3.11). Nullable: токены, выданные до внедрения WebSession, и админские
  // сессии её не имеют — код обязан работать с обоими вариантами.
  //
  // onDelete: Cascade НЕ ставим: сессии не удаляются, а помечаются
  // revoked — история токенов внутри сессии остаётся для reuse-detection.
  sessionId String?
  session   WebSession? @relation(fields: [sessionId], references: [id])

  @@index([userId])
  // Ротация и отзыв идут в пределах одной сессии (см. reuse-detection в
  // webAuthController.refresh — он скоупится на sessionId, а не на userId).
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Браузерная сессия (BROWSER_ACCESS_PLAN.md §3.11, решение D).
//
// Долгоживущее состояние сессии НЕ вешается на RefreshToken: тот
// короткоживущий и ротируется каждые несколько минут, и переносить на новую
// запись subscriptionOk/lastSubscriptionCheckAt при каждой ротации — лишняя
// работа и лишний источник рассинхрона. Токены ротируют ВНУТРИ сессии,
// метаданные живут на ней.
//
// Только для веба. Mini App сессий не создаёт: там нет refresh-токена,
// приложение переавторизуется через /auth/telegram при каждом открытии.
// ---------------------------------------------------------------------------
model WebSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  // Кэш проверки подписки на канал. Обновляется enforceWebSubscription и
  // /auth/subscription-recheck не чаще раза в WEB_SUBSCRIPTION_RECHECK_HOURS
  // (дефолт 24) — именно этот кэш не даёт каждому запросу к каталогу бить в
  // telegram-gateway. Дефолт true: сессия создаётся только после успешного
  // входа, где подписка уже проверена.
  subscriptionOk          Boolean   @default(true)
  lastSubscriptionCheckAt DateTime?

  // Метаданные для будущего экрана «активные сессии / выйти везде» — UI в
  // первой версии не делаем, но поля заводим сразу, чтобы не городить
  // вторую миграцию.
  userAgent String?
  ip        String?

  revoked   Boolean   @default(false)
  revokedAt DateTime?

  refreshTokens RefreshToken[]

  // Отзыв всех сессий пользователя: logout-everywhere, revokeAccess,
  // снятие WEB_ACCESS.
  @@index([userId])
}

// Status of a regular user's request to become an author (login/password +
// AuthorApplication implementation_plan.md). Submitted from the mini app or
// the support bot, reviewed by an admin.
enum ApplicationStatus {
  // Заявка ещё заполняется в боте: пользователь выбрал логин (тот держится
  // за ним), но не подтвердил отправку. Администратору не видна. Живёт
  // сутки без изменений, потом убирается фоновой задачей и логин
  // освобождается (BROWSER_ACCESS_PLAN — self-serve логин автора).
  DRAFT
  PENDING
  NEEDS_INFO
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// A user's request to become an author. At most one DRAFT-or-PENDING
// application per user — enforced by a partial unique index Prisma can't
// express in schema syntax; add it manually to the generated migration SQL
// (same pattern as Draft_active_patternId_key below):
//
//   CREATE UNIQUE INDEX "AuthorApplication_open_userId_key"
//     ON "AuthorApplication"("userId")
//     WHERE status IN ('DRAFT', 'PENDING');
//
// DRAFT is included so a user can't accumulate several half-filled drafts
// (each holding a login). NEEDS_INFO and REJECTED are NOT covered (the user
// can resubmit once out of NEEDS_INFO, and REJECTED has its own 24h cooldown
// enforced in application code via processedAt, not the DB).
// ---------------------------------------------------------------------------
model AuthorApplication {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  authorName String   @db.VarChar(120)
  // Max 10 URLs, each max 500 chars — enforced in authorApplicationController,
  // not at the DB level (Postgres text[] has no per-element length constraint).
  resources  String[]

  // Логин, который пользователь выбрал себе для входа в кабинет. Пока
  // заявка жива и не отклонена, логин считается занятым (проверка занятости
  // смотрит и на UserCredential.login, и сюда). Очищается при отклонении —
  // тогда логин снова свободен. null у заявок, поданных до внедрения
  // self-serve логина: approve для них придумывает логин из имени, как раньше.
  desiredLogin String?

  status       ApplicationStatus @default(PENDING)
  // Set by an admin on needs-info/reject; explains what's missing or why.
  adminComment String?
  // The applicant's free-text reply to adminComment, submitted via the bot's
  // "Ответить" flow (see /internal/bot/author-application/respond). Overwritten
  // on each reply — no history kept; a second NEEDS_INFO round on the same
  // application clobbers the previous response, which is an accepted gap for
  // now (rare case).
  userResponse String?

  // Who/when this application was last moved out of PENDING/NEEDS_INFO.
  // processedAt (not updatedAt) anchors the 24h reapply cooldown after
  // REJECTED — updatedAt would also move on an unrelated adminComment edit.
  processedById String?
  processedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  // Поиск занятости логина среди живых заявок + подбор брошенных черновиков
  // фоновой задачей (добавлен в миграции 20260902100100).
  @@index([desiredLogin])
}

// ---------------------------------------------------------------------------
// Login/password credentials for web access — an alternative to the Telegram
// OTP flow (webAuthController.ts), not a replacement. Both lead to the same
// User. One credential per user (1:1, enforced by userId @unique below).
//
// Раньше называлась AuthorCredential и обслуживала только авторский кабинет.
// Переименована при вводе браузерного доступа (BROWSER_ACCESS_PLAN.md §3.1,
// решение A1): учётка для входа и доступ в кабинет — разные вещи. Кабинет —
// это Permission.AUTHOR_CABINET ПОВЕРХ обычной учётки, а не отдельный вид
// учётки; они были склеены исторически. Сама модель не изменилась, только имя.
// ---------------------------------------------------------------------------
model UserCredential {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Хранится ВСЕГДА в нижнем регистре — нормализация на запись во всех
  // контроллерах (BROWSER_ACCESS_PLAN.md §4.1). У авторских логинов это было
  // не важно (машинный slug всегда lowercase), но пользователь придумывает
  // логин сам, и без нормализации "Masha"/"masha" стали бы двумя аккаунтами.
  // Max 60 chars (see generateSlug in utils/slug.ts + resolveUniqueLogin).
  login        String @unique
  passwordHash String

  // True on every credential issuance (approve, direct grant, resend) —
  // forces a change before the temp password can be used for anything past
  // /change-password. See implementation_plan.md §3.2 step 8.
  mustChangePassword Boolean   @default(true)
  // Set after MAX_LOGIN_ATTEMPTS consecutive failures; cleared on success or
  // on a password change/reset. Not the same as a permanent ban — this is a
  // rolling lockout window (see webAuthController.ts's LOGIN_LOCK_MS).
  lockedUntil        DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  // Admin userId who issued this credential (approve or direct grant) —
  // audit trail only, no FK (admin accounts can be deleted independently).
  // Nullable и для self-serve: когда учётку создаёт сам пользователь через
  // бота, выдавшего админа нет.
  createdById String?
}

// ---------------------------------------------------------------------------
// Author cabinet — granular permissions per user.
// ---------------------------------------------------------------------------
model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission

  @@unique([userId, permission])
}

// ---------------------------------------------------------------------------
// Draft — proposed create or edit of a Pattern by a linked author.
//
// patternId = null  → new pattern proposal
// patternId ≠ null  → edit of an existing published pattern
//
// At most one *active* draft per pattern is enforced in application code.
// The DB-level guarantee requires a partial unique index that Prisma cannot
// express in schema syntax; add it manually to the generated migration SQL:
//
//   CREATE UNIQUE INDEX "Draft_active_patternId_key"
//     ON "Draft"("patternId")
//     WHERE "closedAt" IS NULL AND "patternId" IS NOT NULL;
//
// Closed drafts (closedAt IS NOT NULL) are retained as audit log.
// ---------------------------------------------------------------------------
model Draft {
  id                String      @id @default(uuid())
  patternId         String?
  pattern           Pattern?    @relation(fields: [patternId], references: [id])
  authorId          String
  author            Author      @relation(fields: [authorId], references: [id])
  status            DraftStatus @default(DRAFT)
  moderationComment String?
  title             String
  url               String
  imageUrl          String
  // Same role/derivation as Pattern.thumbnailUrl — see the comment there.
  thumbnailUrl      String?
  images            String[]    @default([])
  details           String?
  price             Decimal?    @db.Decimal(10, 2)
  oldPrice          Decimal?    @db.Decimal(10, 2)
  isFree            Boolean     @default(false)
  isNew             Boolean     @default(false)
  densityStitches   Decimal?    @db.Decimal(5, 2)
  densityRows       Decimal?    @db.Decimal(5, 2)
  closedAt          DateTime?
  closedById        String?
  closedBy          User?       @relation("DraftClosedBy", fields: [closedById], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tags        Tag[]
  categories  ProductType[]
  instruments Instrument[]
  yarnRanges  YarnRange[]
  yarns       DraftYarn[]

  @@index([patternId])
  @@index([authorId])
  @@index([status])
}

// Артикулы пряжи, выбранные автором в форме черновика — до approveDraft это
// живёт отдельно от PatternYarn (которая существует только у опубликованного
// Pattern). Упрощённая версия PatternYarn: нет source/matchRule/rawMention —
// это всегда ручной выбор автора через YarnPicker, не результат разбора
// скрапером/бэкофилом, разбирать тут нечего.
model DraftYarn {
  id      String @id @default(uuid())
  draftId String
  draft   Draft  @relation(fields: [draftId], references: [id], onDelete: Cascade)
  yarnId  String
  yarn    Yarn   @relation(fields: [yarnId], references: [id])

  createdAt DateTime @default(now())

  @@unique([draftId, yarnId])
  @@index([draftId])
  @@index([yarnId])
}

// ---------------------------------------------------------------------------
// Author Sync — auto-sync feature for parsing author sites
// ---------------------------------------------------------------------------
enum AuthorSyncReportStatus {
  PENDING
  PROCESSED
}

enum AuthorSyncItemStatus {
  PENDING
  APPROVED
  REJECTED
}

model AuthorSyncReport {
  id        String                 @id @default(uuid())
  authorId  String
  author    Author                 @relation(fields: [authorId], references: [id])
  status    AuthorSyncReportStatus @default(PENDING)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  items AuthorSyncItem[]

  @@index([status])
}

model AuthorSyncItem {
  id         String               @id @default(uuid())
  reportId   String
  report     AuthorSyncReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status     AuthorSyncItemStatus @default(PENDING)
  url        String
  title      String
  parsedData Json

  @@unique([reportId, url])
  @@index([reportId])
}

// One row per check_price_updates.py run (cron, twice daily — see
// DETAILS_PRICE_PARSING_PROCESS.md). Written directly by the Python script
// via psycopg2 (same pattern as the rest of that pipeline — raw SQL, not
// through this Node app), read by the admin "Справочник" page. Telegram
// only fires when errorsCount > 0; a clean run is visible ONLY here.
model PriceCheckRun {
  id          String   @id @default(uuid())
  startedAt   DateTime
  finishedAt  DateTime
  checked     Int
  changed     Int
  errorsCount Int
  // Arrays of {author, title, url, oldPrice, oldOldPrice, newPrice, newOldPrice}
  // and {author, url, error} — same shape as check_price_updates.py's
  // in-memory `changes`/`errors` lists, just serialized.
  changes     Json
  errors      Json
  // {author, url, nights}[] — patterns that hit ESCALATION_THRESHOLD this
  // run (see price_check_state.json). Empty most runs.
  escalations Json
  createdAt   DateTime @default(now())

  // null = уведомления о снижении цены по этому прогону ещё не разосланы.
  // Ставится джобом priceAlertDispatcher после рассылки. НЕ @default(now()):
  // null нужен именно для разделения «новая запись» vs «обработана».
  // Python-скрипт вставляет строку явным списком колонок (save_run_to_db),
  // новая колонка не упомянута и получает NULL. Исторические строки
  // бэкофиллятся в миграции.
  alertsDispatchedAt DateTime?

  @@index([startedAt])
}

// ---------------------------------------------------------------------------
// Подписка пользователя на снижение цены конкретного описания
// (implementation_plan.md — «Подписка на цены»). Уведомления шлёт джоб
// priceAlertDispatcher, разбирая PriceCheckRun.changes. Отзыв PRICE_ALERT
// строки не удаляет — диспетчер проверяет разрешение перед отправкой.
// ---------------------------------------------------------------------------
model PriceAlert {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patternId String
  pattern   Pattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, patternId])
  @@index([patternId]) // пакетный обход при рассылке
  @@index([userId]) // GET /price-alerts
}

// ---------------------------------------------------------------------------
// Robokassa payments — plain history/accounting, does NOT participate in
// access logic (see PAYMENTS_ROBOKASSA_PLAN.md §5.1). Access is decided by
// UserPermission + User.premiumExpiresAt; this table exists so every charge
// has a record, a receipt-sent flag, and a numeric order id.
// invId is separate from id: Robokassa requires a plain numeric InvId, not
// a UUID, so it gets its own autoincrement column rather than reusing id.
// ---------------------------------------------------------------------------
model Payment {
  id            String         @id @default(uuid())
  invId         Int            @unique @default(autoincrement())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(10, 2)
  status        PaymentStatus  @default(PENDING)
  createdAt     DateTime       @default(now())
  paidAt        DateTime?
  // Set once the Robokassa-generated receipt has been sent to the user's
  // bot chat, so a Result URL retry doesn't send it twice.
  receiptSentAt DateTime?
  // Откуда пользователь пришёл к оплате. Nullable: платежи, созданные до
  // появления аналитики, источника не знают, и задним числом его не
  // вычислить. Заполняется при создании платежа из того, какая шторка была
  // открыта.
  source        PaywallSource?

  @@index([userId])
  // Для воронки и статистики продлений: выборки всегда по периоду
  // (createdAt/paidAt) — см. §10.
  @@index([status, paidAt])
}

// Append-only лог событий баннера подписки — по образцу PatternView/
// SearchQuery. Одна строка на событие; воронка считается по УНИКАЛЬНЫМ
// пользователям за период, а не по числу строк: один человек видит баннер
// ~4 раза в месяц, и смешение оснований занизило бы конверсию (§10.2).
model PaywallEvent {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PaywallEventType
  source    PaywallSource
  // Откуда пришло событие: 'miniapp' (Telegram) или 'web' (браузер).
  // Nullable — события до появления браузерной версии платформы не знают,
  // все они фактически из Mini App (BROWSER_ACCESS_PLAN.md §4.5, P2).
  platform  String?
  createdAt DateTime         @default(now())

  // Воронка группирует по (type, source) в границах периода — этим
  // индексом и читается.
  @@index([createdAt, type, source])
  @@index([userId])
}

// Ответ на winback-опрос ("Давно вас не было видно…", сентябрь 2026) —
// первая инфраструктура сбора причин оттока в проекте (раньше не было
// вообще никакого сигнала, почему платные подписчики перестают заходить).
// Отдельная строка на каждый ответ, не апдейт единственного поля на User:
// один и тот же пользователь может отвечать в разные периоды неактивности
// (см. winbackCheckinSentAt на User), и видеть только последний ответ
// значило бы терять историю.
model WinbackResponse {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    WinbackReason
  createdAt DateTime      @default(now())
  // Просмотрен ли ответ админом на вкладке Winback (Обращения) — тот же
  // смысл, что unreadCount у обычных обращений (chatController.ts),
  // отдельное поле здесь, а не общий механизм: WinbackResponse и
  // BotInboundMessage — разные таблицы, объединять их состояние
  // "прочитано" через общий AdminChatState было бы сложнее, чем один
  // булев флаг на саму запись.
  isRead    Boolean       @default(false)

  @@index([userId])
  @@index([createdAt, reason])
  @@index([isRead])
}

enum WinbackReason {
  DIDNT_FIND_PATTERN
  HARD_TO_USE
  ALL_GOOD
}

// ─── Хранилище пряжи пользователя (YARN_STASH_PLAN.md) ────────────────────
// Один Yarn (артикул из справочника или PENDING-заявка пользователя) может
// быть представлен несколькими StashSkein — разный цвет/партия одной и той
// же пряжи (план §1.4 — та же логика "многие записи на один артикул", что у
// PatternYarn, только в другую сторону: здесь много СВОИХ экземпляров на
// один справочный Yarn).
model StashSkein {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  yarnId String
  yarn   Yarn   @relation(fields: [yarnId], references: [id])

  // Снимок полей Yarn на момент добавления — ВСЕГДА копируется при создании,
  // независимо от статуса артикула (APPROVED/PENDING). Один путь чтения для
  // всех карточек: экран хранилища всегда читает отсюда, никогда через
  // yarn.* напрямую. Если справочник потом уточнит данные (например,
  // модератор поправит метраж), в карточке пользователя останется снятое
  // значение, пока он сам не обновит его явным действием «обновить из
  // справочника» — сознательный компромисс (план §2, актуальность вместо
  // ветвления по Yarn.status).
  yarnNameSnapshot    String
  brandSnapshot       String?
  mPer100gSnapshot    Int?
  compositionSnapshot String?

  colorName      String?
  // Партия/лот окраски — важно, оттенок одной и той же партии красителя
  // отличается от партии к партии.
  dyelot         String?
  // Исходный вес на момент добавления.
  totalWeightG   Int
  // Текущий остаток — изменяется ТОЛЬКО атомарно вместе со вставкой/удалением
  // соответствующей StashUsage в одной транзакции (план §3, UPDATE ... WHERE
  // guard) — никогда прямым присвоением из контроллера.
  currentWeightG Int
  note           String?
  images         String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  swatches StashSwatch[]
  usages   StashUsage[]

  @@index([userId])
  @@index([yarnId])
}

// Отвязанный образец (свотч) — плотность и спицы конкретной вязки, не самого
// артикула (у одной и той же пряжи плотность гуляет в зависимости от спиц,
// натяжения вязальщицы). Несколько на один StashSkein.
model StashSwatch {
  id      String     @id @default(uuid())
  skeinId String
  skein   StashSkein @relation(fields: [skeinId], references: [id], onDelete: Cascade)

  images                String[] @default([])
  needleSizeRaw         String?
  // Плотность ДО ВТО — тот же формат чисел, что у Pattern.densityStitches/Rows.
  densityStitchesBefore Decimal? @db.Decimal(5, 2)
  densityRowsBefore     Decimal? @db.Decimal(5, 2)
  // Плотность ПОСЛЕ ВТО.
  densityStitchesAfter  Decimal? @db.Decimal(5, 2)
  densityRowsAfter      Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@index([skeinId])
}

// Лог расхода запаса — append-only, по образцу PatternView/PaywallEvent.
// patternId опционален: пользователь может списать вес без указания, на что.
//
// pattern Pattern? без onDelete был бы RESTRICT по умолчанию в
// Prisma/Postgres — adminPatternsController.ts уже сегодня делает
// prisma.pattern.delete() для архивных паттернов, и это удаление начало бы
// падать FK constraint violation, как только у паттерна появится хотя бы
// одна StashUsage. Решение (план §2): при удалении Pattern связь не молча
// обнуляется без следа — SetNull обнуляет только "живую" ссылку patternId,
// а *Snapshot-поля ниже сохраняют текстовый артефакт независимо от того,
// удалят ли Pattern позже.
model StashUsage {
  id      String     @id @default(uuid())
  skeinId String
  skein   StashSkein @relation(fields: [skeinId], references: [id], onDelete: Cascade)
  // Положительное число — сколько списано, в граммах.
  amountG Int

  // Основной размер спиц для этого конкретного списания (шаг 1, Figma
  // node-id=1287:16147, обновлённый макет) — свободный текст (то же "Введите
  // число", что и остальные размерные поля в проекте), не связан со
  // StashSwatch.needleSizeRaw: там спицы для образца плотности, здесь —
  // спицы, которыми реально вязался этот конкретный проект.
  needleSizeRaw String?

  // Свободный текст «Название проекта» (шаг 2 флоу списания, Figma
  // node-id=1348:10906) — вводится пользователем сам про свой собственный
  // проект, НЕ связан с Pattern.title. Показывается в карточке пряжи
  // (Figma node-id=1326:9970, блок "Связано").
  projectTitle String?

  // Живая ссылка — используется, пока Pattern существует (переход на
  // карточку из истории списаний). onDelete: SetNull — при удалении
  // паттерна это поле обнуляется, но снимок ниже остаётся.
  patternId String?
  pattern   Pattern? @relation(fields: [patternId], references: [id], onDelete: SetNull)

  // Снимок — пишется ВСЕГДА в момент создания StashUsage, если patternId
  // указан (независимо от того, удалят ли Pattern потом). Переживает
  // удаление паттерна из каталога.
  patternTitleSnapshot  String?
  patternAuthorSnapshot String?

  // Опциональные фото готового изделия (шаг 3, Figma node-id=1319:9182) —
  // тот же upload-пайплайн, что у фото мотка/образца. Массив, а не одно
  // поле — макет показывает несколько фото с тем же "первое фото — обложка"
  // паттерном, что и StashSkein.images/StashSwatch.images.
  finishedPhotos String[] @default([])

  note      String?
  createdAt DateTime @default(now())

  @@index([skeinId])
  @@index([patternId])
}
